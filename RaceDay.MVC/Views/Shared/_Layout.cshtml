<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#f6f5ef" />
    <title>@ViewData["Title"] · RaceDay</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/RaceDay.MVC.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <nav class="navbar navbar-expand-lg site-nav" aria-label="Main navigation">
            <div class="container nav-inner">
                <a class="navbar-brand brand" asp-controller="Home" asp-action="Index" aria-label="RaceDay home">
                    <span class="brand-mark" aria-hidden="true">R</span><span>race<span class="brand-light">day</span></span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavigation" aria-controls="mainNavigation" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNavigation">
                    <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2">
                        @if (Context.Session.GetString("UserRole") == "Participant")
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Participants" asp-action="Profile">My race profile</a></li>
                        }
                        @if (Context.Session.GetString("UserRole") == "Organiser")
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Organiser" asp-action="Dashboard">Organiser dashboard</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Events" asp-action="Index">My events</a></li>
                        }
                        @if (Context.Session.GetString("UserRole") is not null)
                        {
                            <li class="nav-item ms-lg-2">
                                <form asp-controller="Account" asp-action="Logout" method="post">
                                    <button type="submit" class="btn btn-nav">Log out</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Login">Log in</a></li>
                            <li class="nav-item ms-lg-2"><a class="btn btn-nav" asp-controller="Account" asp-action="Register">Join the start list <span aria-hidden="true">↗</span></a></li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container footer-inner">
            <a class="brand footer-brand" asp-controller="Home" asp-action="Index"><span class="brand-mark" aria-hidden="true">R</span><span>race<span class="brand-light">day</span></span></a>
            <span class="footer-note">Made for the miles that bring us together.</span>
            <span class="footer-copy">© 2026 RaceDay</span>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
